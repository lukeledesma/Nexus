<% show_save = local_assigns.fetch(:show_save, false) %>
<% show_open = local_assigns.fetch(:show_open, false) %>
<% linked_app_save_flow = local_assigns.fetch(:linked_app_save_flow, false) %>
<% open_file_badge = local_assigns.fetch(:open_file_badge, false) %>
<% show_finder_new_folder = local_assigns.fetch(:show_finder_new_folder, false) %>
<% show_finder_search_toggle = local_assigns.fetch(:show_finder_search_toggle, false) %>
<% show_task_list_add = local_assigns.fetch(:show_task_list_add, false) %>
<% show_calendar_new_event = local_assigns.fetch(:show_calendar_new_event, false) %>
<% show_set_wallpaper = local_assigns.fetch(:show_set_wallpaper, false) %>
<% show_alchemy_conflict_toggle = local_assigns.fetch(:show_alchemy_conflict_toggle, false) %>
<% show_alchemy_raw_toggle = local_assigns.fetch(:show_alchemy_raw_toggle, false) %>
<% show_alchemy_tag_count = local_assigns.fetch(:show_alchemy_tag_count, false) %>
<% show_command_shell = linked_app_save_flow || show_finder_new_folder || show_finder_search_toggle || show_task_list_add || show_calendar_new_event || show_save || show_open || show_set_wallpaper || show_alchemy_conflict_toggle || show_alchemy_raw_toggle %>

<header class="content-window-chrome <%= "content-window-chrome--with-open-file" if open_file_badge %>">
  <% if open_file_badge %>
    <h2 class="content-window-chrome-title">
      <span class="content-window-open-file-name" data-nexus-open-file-name><%= title %></span>
      <% if show_alchemy_tag_count %>
        <span class="content-window-open-file-separator" aria-hidden="true">-</span>
        <span class="content-window-alchemy-tag-count" data-nexus-alchemy-tag-count hidden></span>
      <% end %>
      <span class="content-window-open-file-edited" data-nexus-open-file-edited hidden aria-hidden="true">saving</span>
    </h2>
  <% else %>
    <h2 class="content-window-chrome-title"><%= title %></h2>
  <% end %>

  <% if show_command_shell %>
    <% if linked_app_save_flow %>
      <div data-content-window-target="chromeAppTools" class="content-window-chrome-tool-group content-window-chrome-actions content-window-chrome-app-tools">
        <% if show_task_list_add %>
          <button
            type="button"
            class="content-window-new-folder-btn settings-themes-item-action-btn theme-builder-save-btn"
            data-action="click->content-window#emitTaskListAddTask"
            title="Add task"
            aria-label="Add task"
          ><%= material_symbol_icon(:add, size: :xs) %></button>
        <% end %>
        <% if show_set_wallpaper %>
          <button
            type="button"
            class="tools-close-btn content-window-set-wallpaper"
            data-action="click->content-window#setLinkedImageAsWallpaper"
            aria-label="Set as wallpaper"
            title="Set as wallpaper"
          ><%= material_symbol_icon(:desktop_windows, size: :sm) %></button>
        <% end %>
        <% if show_alchemy_raw_toggle %>
          <button
            type="button"
            class="content-window-new-folder-btn settings-themes-item-action-btn theme-builder-save-btn content-window-alchemy-raw-toggle"
            data-alchemy-raw-toggle
            data-action="click->content-window#toggleAlchemyRawView"
            title="Show raw file"
            aria-label="Show raw file"
            aria-pressed="false">
            <span data-alchemy-raw-icon="off" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="currentColor"><path d="M607.5-372.5Q660-425 660-500t-52.5-127.5Q555-680 480-680t-127.5 52.5Q300-575 300-500t52.5 127.5Q405-320 480-320t127.5-52.5Zm-204-51Q372-455 372-500t31.5-76.5Q435-608 480-608t76.5 31.5Q588-545 588-500t-31.5 76.5Q525-392 480-392t-76.5-31.5ZM214-281.5Q94-363 40-500q54-137 174-218.5T480-800q146 0 266 81.5T920-500q-54 137-174 218.5T480-200q-146 0-266-81.5ZM480-500Zm207.5 160.5Q782-399 832-500q-50-101-144.5-160.5T480-720q-113 0-207.5 59.5T128-500q50 101 144.5 160.5T480-280q113 0 207.5-59.5Z"/></svg>
            </span>
            <span data-alchemy-raw-icon="on" aria-hidden="true" hidden>
              <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="currentColor"><path d="m644-428-58-58q9-47-27-88t-93-32l-58-58q17-8 34.5-12t37.5-4q75 0 127.5 52.5T660-500q0 20-4 37.5T644-428Zm128 126-58-56q38-29 67.5-63.5T832-500q-50-101-143.5-160.5T480-720q-29 0-57 4t-55 12l-62-62q41-17 84-25.5t90-8.5q151 0 269 83.5T920-500q-23 59-60.5 109.5T772-302Zm20 246L624-222q-35 11-70.5 16.5T480-200q-151 0-269-83.5T40-500q21-53 53-98.5t73-81.5L56-792l56-56 736 736-56 56ZM222-624q-29 26-53 57t-41 67q50 101 143.5 160.5T480-280q20 0 39-2.5t39-5.5l-36-38q-11 3-21 4.5t-21 1.5q-75 0-127.5-52.5T300-500q0-11 1.5-21t4.5-21l-84-82Zm319 93Zm-151 75Z"/></svg>
            </span>
          </button>
        <% end %>
        <% if show_alchemy_conflict_toggle %>
          <button
            type="button"
            class="content-window-new-folder-btn settings-themes-item-action-btn theme-builder-save-btn content-window-alchemy-conflict-toggle"
            data-alchemy-conflict-toggle
            data-action="click->content-window#toggleAlchemyConflictFilter"
            title="Show conflicts only"
            aria-label="Show conflicts only"
            aria-pressed="false">
            <span data-alchemy-conflict-icon="off" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960" width="16" height="16" fill="currentColor"><path d="m40-120 440-760 440 760H40Zm138-80h604L480-720 178-200Zm330.5-51.5Q520-263 520-280t-11.5-28.5Q497-320 480-320t-28.5 11.5Q440-297 440-280t11.5 28.5Q463-240 480-240t28.5-11.5ZM440-360h80v-200h-80v200Zm40-100Z"/></svg>
            </span>
            <span data-alchemy-conflict-icon="on" aria-hidden="true" hidden>
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960" width="16" height="16" fill="currentColor"><path d="M451.5-251.5Q440-263 440-280t11.5-28.5Q463-320 480-320t28.5 11.5Q520-297 520-280t-11.5 28.5Q497-240 480-240t-28.5-11.5ZM440-360v-161l80 80v81h-80Zm433 158L655-419 480-720l-47 80-58-58 105-182 393 678Zm-695 2h469L350-497 178-200ZM819-28l-92-92H40l252-435L27-820l57-57L876-85l-57 57ZM499-348Zm45-181Z"/></svg>
            </span>
          </button>
        <% end %>
        <% if show_open %>
          <button
            type="button"
            class="content-window-new-folder-btn settings-themes-item-action-btn theme-builder-save-btn"
            data-action="click->content-window#openLinkedAppSavePicker"
            title="Open from Finder"
            aria-label="Open from Finder"
          ><%= material_symbol_icon(:folder, size: :sm) %></button>
        <% end %>
        <% if show_save %>
          <button
            type="button"
            class="content-window-save-btn settings-themes-item-action-btn theme-builder-save-btn"
            data-action="click->content-window#openLinkedAppSavePicker"
            title="Save/Open"
            aria-label="Save/Open"
          ><%= material_symbol_icon(:folder, size: :sm) %></button>
        <% end %>
      </div>
      <div data-content-window-target="chromePickerTools" class="content-window-chrome-tool-group content-window-chrome-actions content-window-chrome-picker-tools" hidden>
        <button
          type="button"
          class="content-window-new-folder-btn settings-themes-item-action-btn theme-builder-save-btn content-window-back-btn"
          data-action="click->content-window#closeLinkedAppSavePicker"
          title="Back"
          aria-label="Back to app"
        ><%= material_symbol_icon(:arrow_back, size: :sm) %></button>
      </div>
    <% else %>
      <div class="content-window-chrome-tool-group content-window-chrome-actions">
        <% if show_finder_search_toggle %>
          <button
            type="button"
            class="content-window-search-toggle settings-themes-item-action-btn theme-builder-save-btn"
            data-finder-toolbar-target="searchToggle"
            data-action="click->finder-toolbar#toggleSearchMode"
            title="Search all files"
            aria-label="Search all files"
            aria-pressed="false"
          ><%= material_symbol_icon(:search, size: :xs) %></button>
        <% end %>
        <% if show_finder_new_folder %>
          <button
            type="button"
            class="content-window-new-folder-btn settings-themes-item-action-btn theme-builder-save-btn"
            data-action="click->finder-toolbar#createInRoot"
            title="New folder in Finder"
            aria-label="New folder in Finder"
          ><%= material_symbol_icon(:add, size: :xs) %></button>
        <% end %>
        <% if show_task_list_add %>
          <button
            type="button"
            class="content-window-new-folder-btn settings-themes-item-action-btn theme-builder-save-btn"
            data-action="click->content-window#emitTaskListAddTask"
            title="Add task"
            aria-label="Add task"
          ><%= material_symbol_icon(:add, size: :xs) %></button>
        <% end %>
        <% if show_calendar_new_event %>
          <button
            type="button"
            class="content-window-new-folder-btn settings-themes-item-action-btn theme-builder-save-btn"
            data-action="click->content-window#emitCalendarNewEvent"
            title="New event"
            aria-label="New event"
          ><%= material_symbol_icon(:add, size: :xs) %></button>
        <% end %>
        <% if show_save %>
          <button
            type="button"
            class="content-window-save-btn settings-themes-item-action-btn theme-builder-save-btn"
            data-action="click->content-window#openSaveDialog"
            title="Save As"
            aria-label="Save As"
          ><%= material_symbol_icon(:save, size: :sm) %></button>
        <% end %>
        <% if show_set_wallpaper %>
          <button
            type="button"
            class="tools-close-btn content-window-set-wallpaper"
            data-action="click->content-window#setLinkedImageAsWallpaper"
            aria-label="Set as wallpaper"
            title="Set as wallpaper"
          ><%= material_symbol_icon(:desktop_windows, size: :sm) %></button>
        <% end %>
      </div>
    <% end %>
  <% end %>

  <%= render "shared/content_window_close_button" %>
</header>
