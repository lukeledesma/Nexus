<% show_save = local_assigns.fetch(:show_save, false) %>
<% show_open = local_assigns.fetch(:show_open, false) %>
<% linked_app_save_flow = local_assigns.fetch(:linked_app_save_flow, false) %>
<% open_file_badge = local_assigns.fetch(:open_file_badge, false) %>
<% show_finder_new_folder = local_assigns.fetch(:show_finder_new_folder, false) %>
<% show_task_list_add = local_assigns.fetch(:show_task_list_add, false) %>
<% show_calendar_new_event = local_assigns.fetch(:show_calendar_new_event, false) %>
<% show_set_wallpaper = local_assigns.fetch(:show_set_wallpaper, false) %>
<% show_command_shell = linked_app_save_flow || show_finder_new_folder || show_task_list_add || show_calendar_new_event || show_save || show_open || show_set_wallpaper %>

<header class="content-window-chrome <%= "content-window-chrome--with-open-file" if open_file_badge %>">
  <% if open_file_badge %>
    <h2 class="content-window-chrome-title">
      <span class="content-window-open-file-name" data-nexus-open-file-name><%= title %></span>
      <span class="content-window-open-file-edited" data-nexus-open-file-edited hidden aria-hidden="true">saving</span>
    </h2>
  <% else %>
    <h2 class="content-window-chrome-title"><%= title %></h2>
  <% end %>

  <% if show_command_shell %>
    <% if linked_app_save_flow %>
      <div data-content-window-target="chromeAppTools" class="content-window-chrome-tool-group content-window-chrome-actions content-window-chrome-app-tools">
        <% if show_task_list_add %>
          <button
            type="button"
            class="content-window-new-folder-btn settings-themes-item-action-btn theme-builder-save-btn"
            data-action="click->content-window#emitTaskListAddTask"
            title="Add task"
            aria-label="Add task"
          ><%= material_symbol_icon(:add, size: :xs) %></button>
        <% end %>
        <% if show_set_wallpaper %>
          <button
            type="button"
            class="tools-close-btn content-window-set-wallpaper"
            data-action="click->content-window#setLinkedImageAsWallpaper"
            aria-label="Set as wallpaper"
            title="Set as wallpaper"
          ><%= material_symbol_icon(:desktop_windows, size: :sm) %></button>
        <% end %>
        <% if show_open %>
          <button
            type="button"
            class="content-window-new-folder-btn settings-themes-item-action-btn theme-builder-save-btn"
            data-action="click->content-window#openLinkedAppSavePicker"
            title="Open from Finder"
            aria-label="Open from Finder"
          ><%= material_symbol_icon(:folder, size: :sm) %></button>
        <% end %>
        <% if show_save %>
          <button
            type="button"
            class="content-window-save-btn settings-themes-item-action-btn theme-builder-save-btn"
            data-action="click->content-window#openLinkedAppSavePicker"
            title="Save/Open"
            aria-label="Save/Open"
          ><%= material_symbol_icon(:folder, size: :sm) %></button>
        <% end %>
      </div>
      <div data-content-window-target="chromePickerTools" class="content-window-chrome-tool-group content-window-chrome-actions content-window-chrome-picker-tools" hidden>
        <button
          type="button"
          class="content-window-new-folder-btn settings-themes-item-action-btn theme-builder-save-btn content-window-back-btn"
          data-action="click->content-window#closeLinkedAppSavePicker"
          title="Back"
          aria-label="Back to app"
        ><%= material_symbol_icon(:arrow_back, size: :sm) %></button>
      </div>
    <% else %>
      <div class="content-window-chrome-tool-group content-window-chrome-actions">
        <% if show_finder_new_folder %>
          <button
            type="button"
            class="content-window-new-folder-btn settings-themes-item-action-btn theme-builder-save-btn"
            data-action="click->finder-toolbar#createInRoot"
            title="New folder in Finder"
            aria-label="New folder in Finder"
          ><%= material_symbol_icon(:add, size: :xs) %></button>
        <% end %>
        <% if show_task_list_add %>
          <button
            type="button"
            class="content-window-new-folder-btn settings-themes-item-action-btn theme-builder-save-btn"
            data-action="click->content-window#emitTaskListAddTask"
            title="Add task"
            aria-label="Add task"
          ><%= material_symbol_icon(:add, size: :xs) %></button>
        <% end %>
        <% if show_calendar_new_event %>
          <button
            type="button"
            class="content-window-new-folder-btn settings-themes-item-action-btn theme-builder-save-btn"
            data-action="click->content-window#emitCalendarNewEvent"
            title="New event"
            aria-label="New event"
          ><%= material_symbol_icon(:add, size: :xs) %></button>
        <% end %>
        <% if show_save %>
          <button
            type="button"
            class="content-window-save-btn settings-themes-item-action-btn theme-builder-save-btn"
            data-action="click->content-window#openSaveDialog"
            title="Save As"
            aria-label="Save As"
          ><%= material_symbol_icon(:save, size: :sm) %></button>
        <% end %>
        <% if show_set_wallpaper %>
          <button
            type="button"
            class="tools-close-btn content-window-set-wallpaper"
            data-action="click->content-window#setLinkedImageAsWallpaper"
            aria-label="Set as wallpaper"
            title="Set as wallpaper"
          ><%= material_symbol_icon(:desktop_windows, size: :sm) %></button>
        <% end %>
      </div>
    <% end %>
  <% end %>

  <%= render "shared/content_window_close_button" %>
</header>
