<div
  id="desktop-side-panel-host"
  class="desktop-side-panel-host"
  data-controller="side-panel"
>
  <button
    type="button"
    class="desktop-side-panel-toggle"
    data-side-panel-target="toggle"
    data-action="click->side-panel#toggle"
    aria-expanded="false"
    aria-controls="desktop-side-panel-drawer"
    title="Open panel"
    aria-label="Open side panel"
  ><%= material_symbol_icon(:dock_to_right, size: :md) %></button>

  <aside
    id="desktop-side-panel-drawer"
    class="desktop-side-panel-drawer"
    data-side-panel-target="drawer"
    data-controller="side-panel-search"
    data-side-panel-search-search-url-value="<%= panel_search_documents_path %>"
    role="dialog"
    aria-modal="true"
    aria-label="Nexus apps"
    aria-hidden="true"
  >
    <header class="desktop-side-panel-header">
      <label class="desktop-side-panel-search" aria-label="Search Finder files">
        <span class="desktop-side-panel-search-icon" aria-hidden="true"><%= material_symbol_icon(:tune, size: :xs) %></span>
        <input
          type="search"
          class="desktop-side-panel-search-input"
          placeholder="Search Finder files"
          autocomplete="off"
          spellcheck="false"
          data-side-panel-search-target="input"
          data-action="input->side-panel-search#handleInput keydown->side-panel-search#handleInputKeydown"
        >
      </label>
    </header>

    <div class="desktop-side-panel-body" data-controller="organizer">
      <nav class="desktop-side-panel-apps" aria-label="Apps" data-side-panel-search-target="apps">
        <% launcher_grid_entries.each do |entry| %>
          <button
            type="button"
            class="desktop-side-panel-app-row"
            data-window-key="<%= entry[:window_key] %>"
            data-app-label="<%= entry[:label] %>"
            data-action="click->organizer#launchApp mouseenter->organizer#showAppPreview mouseleave->organizer#scheduleHideAppPreview focus->organizer#showAppPreview blur->organizer#scheduleHideAppPreview"
          >
            <span class="desktop-side-panel-app-icon" aria-hidden="true">
              <% if entry[:icon_svg] %>
                <%= render "shared/quartz_icon" %>
              <% else %>
                <%= material_symbol_icon(entry[:icon], size: :sm) %>
              <% end %>
            </span>
            <span class="desktop-side-panel-app-label"><%= entry[:label] %></span>
            <% if entry[:window_key] == "tasks" || entry[:window_key] == "quartz" %>
              <span class="desktop-side-panel-app-actions" aria-hidden="true">
                <span class="row-plus desktop-side-panel-app-action" data-action="<%= entry[:window_key] == "quartz" ? "click->organizer#addQuartzFromPanel mousedown->organizer#noopAppAction" : "click->organizer#addTaskFromPanel mousedown->organizer#noopAppAction" %>">
                  <%= material_symbol_icon(:add, size: :xs) %>
                </span>
              </span>
            <% end %>
          </button>
        <% end %>
      </nav>

      <nav class="desktop-side-panel-apps" aria-label="Search results" data-side-panel-search-target="results" hidden></nav>
      <p class="desktop-side-panel-search-empty" data-side-panel-search-target="emptyState" hidden>No Finder files matched.</p>

      <div class="desktop-side-panel-user-section" data-side-panel-search-target="userSection">
        <div class="desktop-side-panel-theme-row" data-controller="user-settings">
          <span class="desktop-side-panel-row-icon" aria-hidden="true">
            <%= material_symbol_icon(:palette, size: :sm) %>
          </span>
          <span class="desktop-side-panel-row-label">Theme</span>
          <div class="desktop-side-panel-row-actions">
            <span class="desktop-side-panel-theme-text" data-user-settings-target="themeLabel">System</span>
            <button
              type="button"
              class="item-action-btn"
              title="Cycle theme"
              aria-label="Cycle between system, dark, and light theme"
              data-user-settings-target="themeButton"
              data-action="click->user-settings#cycleTheme"
            >
              <%= material_symbol_icon(:desktop_windows, size: :xs) %>
            </button>
          </div>
        </div>

        <div class="desktop-side-panel-user-row">
          <span class="desktop-side-panel-row-icon" aria-hidden="true">
            <%= material_symbol_icon(:account_circle, size: :sm) %>
          </span>
          <span class="desktop-side-panel-row-label"><%= current_user.username.presence || "User" %></span>
          <div class="desktop-side-panel-row-actions">
            <button
              type="button"
              class="item-action-btn"
              title="Reset password or username"
              aria-label="Open reset options"
              data-action="click->user-security-modal#openSelectorModalWithConfirm"
            >
              <%= material_symbol_icon(:lock_reset, size: :xs, html_class: "desktop-side-panel-action-icon") %>
            </button>

            <%= form_with url: logout_path, method: :delete, local: true, data: { turbo: false }, class: "desktop-side-panel-logout-form" do %>
              <button type="submit" class="item-action-btn" title="Log out" aria-label="Log out">
                <%= material_symbol_icon(:logout, size: :xs, html_class: "desktop-side-panel-action-icon") %>
              </button>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </aside>

  <aside
    id="desktop-side-panel-hover-preview"
    class="desktop-side-panel-hover-preview"
    data-preview-close-icon-html="<%= material_symbol_icon(:close, size: :xs) %>"
    aria-hidden="true"
  ></aside>
</div>
<%# Apply saved open state before first paint so the drawer does not animate on refresh. Matches side_panel_controller STORAGE_OPEN_KEY. %>
<script>
(function () {
  try {
    if (localStorage.getItem("nexus.desktop.sidePanelOpen") !== "1") return
    var host = document.getElementById("desktop-side-panel-host")
    if (!host) return
    host.classList.add("desktop-side-panel-host--open")
    var btn = host.querySelector(".desktop-side-panel-toggle")
    var drawer = host.querySelector(".desktop-side-panel-drawer")
    if (btn) {
      btn.setAttribute("aria-expanded", "true")
      btn.setAttribute("aria-label", "Close side panel")
      btn.setAttribute("title", "Close panel")
      btn.classList.add("is-active")
    }
    if (drawer) drawer.setAttribute("aria-hidden", "false")
  } catch (e) { /* private mode / disabled storage */ }
})()
</script>
