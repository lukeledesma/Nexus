<% frame_id = params[:frame_id].presence || turbo_frame_request_id.presence || "work-timer-pane" %>
<turbo-frame id="<%= frame_id %>">
  <section class="app-surface app-surface--tool work-timer-app os-window-body-start"
    data-controller="work-timer"
    data-work-timer-notes-url-value="<%= apps_work_timer_notes_path %>">
    <header class="work-timer-app__header">
      <div class="work-timer-app__clockin-group">
        <p class="work-timer-app__label">Start Time</p>
        <input id="work-timer-clockin-input" type="text" inputmode="numeric" maxlength="5" class="work-timer-app__time-input"
          placeholder="--:--" aria-label="Clocked in time"
          data-work-timer-target="clockInInput"
          data-action="change->work-timer#updateClockInManual keydown->work-timer#applyClockInOnEnter" />
      </div>

      <div class="work-timer-app__clockout-group">
        <p class="work-timer-app__label">End Time</p>
        <input id="work-timer-clockout-input" type="text" inputmode="numeric" maxlength="5" class="work-timer-app__time-input"
          placeholder="--:--" aria-label="Clocked out time"
          data-work-timer-target="clockOutInput"
          data-action="change->work-timer#updateClockOutManual keydown->work-timer#applyClockOutOnEnter" />
      </div>

      <div class="work-timer-app__elapsed-group">
        <p class="work-timer-app__label">Total</p>
        <p class="work-timer-app__elapsed" data-work-timer-target="elapsedText">00:00:00</p>
      </div>


    </header>

    <section class="work-timer-app__status">
      <p class="work-timer-app__status-line" data-work-timer-target="nextDueText"></p>
      <div class="work-timer-app__progress" role="progressbar" aria-label="Progress to next required entry">
        <div class="work-timer-app__progress-fill" data-work-timer-target="progressFill"></div>
      </div>
      <div class="work-timer-app__status-foot">
        <p class="work-timer-app__status-line work-timer-app__status-line--alert" data-work-timer-target="alertText"></p>
        <p class="work-timer-app__status-line work-timer-app__status-line--ratio" data-work-timer-target="ratioText">0/0</p>
      </div>
    </section>

    <section class="time-card-app__entries">
      <div class="time-card-notes-shell">
        <div class="time-card-notes-backdrop" aria-hidden="true" data-work-timer-target="notesBackdrop"></div>
        <textarea class="time-card-notes-textarea"
          data-work-timer-target="notesInput"
          data-action="input->work-timer#updateNotes scroll->work-timer#syncBackdropScroll"
          placeholder="Write your entry..."
          autocomplete="off"
          spellcheck="true"><%= @notes_text %></textarea>
      </div>
    </section>
  </section>
</turbo-frame>
