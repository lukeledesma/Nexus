<% frame_id = params[:frame_id].presence || "app-pane" %>
<turbo-frame id="<%= frame_id %>" data-singular-draft-root>
  <section class="app-surface app-surface--tool app-surface--sticky-notes"
    data-controller="sticky-notes"
    data-sticky-notes-columns-value="75"
    data-sticky-notes-rows-value="75"
    data-sticky-notes-stickies-value="<%= json_escape(@stickies.to_json) %>"
    data-sticky-notes-viewport-value="<%= json_escape(@sticky_notes_viewport.to_json) %>"
    data-sticky-notes-save-url-value="<%= apps_singular_sticky_notes_path %>">
    <div class="sticky-notes-workspace os-window-body-start">
      <div class="sticky-notes-content-shell app-content-shell" data-sticky-notes-target="contentShell">
        <div class="sticky-notes-canvas" data-sticky-notes-target="canvas">
          <div class="sticky-notes-grid" data-sticky-notes-target="grid" aria-hidden="true"></div>
        </div>
        <div class="sticky-notes-minimap" data-sticky-notes-target="minimap" aria-hidden="true">
          <div class="sticky-notes-minimap__inner">
            <canvas class="sticky-notes-minimap__bitmap" data-sticky-notes-target="minimapBitmap" aria-hidden="true"></canvas>
            <div class="sticky-notes-minimap__viewport" data-sticky-notes-target="minimapViewport"></div>
          </div>
        </div>
      </div>

      <div class="sticky-notes-action-shell" aria-label="Sticky notes actions">
        <button type="button" class="sticky-notes-action-btn" data-sticky-notes-target="gridToggle" data-action="click->sticky-notes#toggleGrid" aria-label="Hide Grid" title="Hide Grid">
          <span data-sticky-notes-target="gridIconOn" class="sticky-notes-grid-toggle-icon" hidden><%= material_symbol_icon(:grid_on, size: :md) %></span>
          <span data-sticky-notes-target="gridIconOff" class="sticky-notes-grid-toggle-icon"><%= material_symbol_icon(:grid_off, size: :md) %></span>
        </button>
        <div class="sticky-notes-sticky-color-anchor sticky-notes-action-btn--hidden" data-sticky-notes-target="stickyColorAnchor">
          <button type="button" class="sticky-notes-action-btn sticky-notes-action-btn--fill-color" data-sticky-notes-target="stickySelection" data-action="click->sticky-notes#toggleStickyColorPopover" aria-hidden="true" tabindex="-1" title="Sticky color" aria-label="Sticky color">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960" class="sticky-notes-toolbar-svg" aria-hidden="true"><path d="m247-904 57-56 343 343q23 23 23 57t-23 57L457-313q-23 23-57 23t-57-23L153-503q-23-23-23-57t23-57l190-191-96-96Zm153 153L209-560h382L400-751Zm303.5 447.5Q680-327 680-360q0-21 12.5-45t27.5-45q9-12 19-25t21-25q11 12 21 25t19 25q15 21 27.5 45t12.5 45q0 33-23.5 56.5T760-280q-33 0-56.5-23.5ZM80 0v-160h800V0H80Z"/></svg>
          </button>
          <div class="sticky-notes-sticky-color-popover sticky-notes-action-btn--hidden" data-sticky-notes-target="colorPopover" aria-hidden="true">
            <div class="sticky-notes-color-swatches" data-sticky-notes-target="fillSwatchGrid" role="group" aria-label="Sticky fill colors"></div>
          </div>
        </div>
        <div class="sticky-notes-text-color-anchor sticky-notes-action-btn--hidden" data-sticky-notes-target="textColorAnchor">
          <button type="button" class="sticky-notes-action-btn sticky-notes-action-btn--text-color" data-sticky-notes-target="textColorSelection" data-action="click->sticky-notes#toggleTextColorPopover" aria-hidden="true" tabindex="-1" title="Text color" aria-label="Text color">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960" class="sticky-notes-toolbar-svg" aria-hidden="true"><path d="M80 0v-160h800V0H80Zm140-280 210-560h100l210 560h-96l-50-144H368l-52 144h-96Zm176-224h168l-82-232h-4l-82 232Z"/></svg>
          </button>
          <div class="sticky-notes-sticky-color-popover sticky-notes-action-btn--hidden" data-sticky-notes-target="textColorPopover" aria-hidden="true">
            <div class="sticky-notes-color-swatches" data-sticky-notes-target="textSwatchGrid" role="group" aria-label="Text colors"></div>
          </div>
        </div>
        <div class="sticky-notes-delete-anchor sticky-notes-action-btn--hidden" data-sticky-notes-target="deleteAnchor">
          <button type="button" class="sticky-notes-action-btn" data-action="click->sticky-notes#deleteSelectedStickies" aria-label="Delete selected notes" title="Delete selected notes"><%= material_symbol_icon(:delete, size: :md) %></button>
        </div>
        <div class="sticky-notes-interaction-toggle-wrap" aria-label="Canvas tool">
          <button type="button" class="sticky-notes-action-btn" data-sticky-notes-target="interactionToggle" data-action="click->sticky-notes#toggleSelectMode" aria-label="Switch to selection mode" title="Switch to selection mode">
            <span data-sticky-notes-target="interactionIconSelect" class="sticky-notes-interaction-toggle-icon"><%= image_tag "sticky-notes-select-24.svg", class: "sticky-notes-toolbar-svg", alt: "" %></span>
            <span data-sticky-notes-target="interactionIconPan" class="sticky-notes-interaction-toggle-icon" hidden><%= image_tag "sticky-notes-drag-pan-24.svg", class: "sticky-notes-toolbar-svg", alt: "" %></span>
          </button>
        </div>
      </div>
    </div>
  </section>
</turbo-frame>
