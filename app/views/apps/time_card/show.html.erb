<% frame_id = params[:frame_id].presence || turbo_frame_request_id.presence || "time-card-pane" %>
<turbo-frame id="<%= frame_id %>" data-linked-app-draft-root data-linked-app-has-linked-document="<%= @linked_document_id.present? %>">
  <section class="app-surface app-surface--tool time-card-app os-window-body-start"
    data-controller="time-card"
    data-time-card-linked-document-id-value="<%= @linked_document_id || 0 %>"
    data-time-card-initial-state-value="<%= json_escape(@initial_state.to_json) %>">
    <% if @linked_document_id.present? %>
      <%= form_with url: document_path(@linked_document_id), method: :patch,
        data: { turbo: false, controller: "autosave", autosave_debounce_value: 180 },
        html: { class: "time-card-app__form" } do %>
        <input type="hidden" name="document[content]" value="<%= @serialized_document_content %>" data-time-card-target="serializedContent">

        <section class="time-card-app__entries">
          <div class="time-card-notes-shell">
            <div class="time-card-notes-backdrop" aria-hidden="true" data-time-card-target="notesBackdrop"></div>
            <textarea class="time-card-notes-textarea"
              data-time-card-target="notesInput"
              data-action="input->time-card#updateNotes scroll->time-card#syncBackdropScroll keydown->time-card#handleNotesKeydown"
              placeholder="10:00-12:00 Customer&#10;- Entry 1&#10;- Entry 2"
              autocomplete="off"
              spellcheck="true"></textarea>
          </div>
        </section>
        <div class="time-card-timeline-shell" data-time-card-target="timelineBar"></div>
      <% end %>
    <% else %>
      <div class="time-card-app__form">
        <input type="hidden" value="" data-time-card-target="serializedContent">

        <section class="time-card-app__entries">
          <div class="time-card-notes-shell">
            <div class="time-card-notes-backdrop" aria-hidden="true" data-time-card-target="notesBackdrop"></div>
            <textarea class="time-card-notes-textarea"
              data-time-card-target="notesInput"
              data-action="input->time-card#updateNotes scroll->time-card#syncBackdropScroll keydown->time-card#handleNotesKeydown"
              placeholder="10:00-12:00 Customer&#10;- Entry 1&#10;- Entry 2"
              autocomplete="off"
              spellcheck="true"></textarea>
          </div>
        </section>
        <div class="time-card-timeline-shell" data-time-card-target="timelineBar"></div>
      </div>
    <% end %>
  </section>
</turbo-frame>
