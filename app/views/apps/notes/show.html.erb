<% frame_id = params[:frame_id].presence || turbo_frame_request_id.presence || "notes-pane" %>
<turbo-frame id="<%= frame_id %>">
  <section class="app-surface app-surface--tool notes-app os-window-body-start">
    <% if @linked_document_id.present? %>
      <%= form_with url: document_path(@linked_document_id), method: :patch,
                    data: {
                      turbo: false,
                      controller: "autosave",
                      autosave_debounce_value: 180
                    },
                    html: { class: "notes-app__form" } do |f| %>
        <%= f.text_area :content,
                        name: "document[content]",
                        value: @note_text,
                        class: "notes-app__textarea",
                        placeholder: "Write your note...",
                        autocomplete: "off",
                        spellcheck: "true" %>
      <% end %>
    <% else %>
      <div class="notes-app__form">
        <textarea
          class="notes-app__textarea"
          data-controller="notes-editor"
          data-notes-editor-frame-id-value="<%= frame_id %>"
          placeholder="Write your note..."
          autocomplete="off"
          spellcheck="true"
        ></textarea>
      </div>
    <% end %>
  </section>
</turbo-frame>
