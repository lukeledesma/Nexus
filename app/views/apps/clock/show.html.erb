<% frame_id = params[:frame_id].presence || turbo_frame_request_id.presence || "clock-pane" %>
<turbo-frame id="<%= frame_id %>">
  <section class="app-surface app-surface--tool clock-app os-window-body-start" data-controller="clock-app">
    <header class="clock-app__tabs" role="tablist" aria-label="Clock modes">
      <button type="button" class="clock-app__tab is-active" data-clock-app-target="tab" data-tab="stopwatch" data-action="clock-app#switchTab" role="tab" aria-selected="true">Stopwatch</button>
      <button type="button" class="clock-app__tab" data-clock-app-target="tab" data-tab="timer" data-action="clock-app#switchTab" role="tab" aria-selected="false">Timer</button>
      <label class="clock-app__sound-toggle" aria-label="Enable sound alerts">
        <input type="checkbox" data-clock-app-target="soundToggle" data-action="change->clock-app#toggleSound" checked>
        <span>Sound</span>
      </label>
    </header>

    <div class="clock-app__notice" data-clock-app-target="notice" hidden></div>

    <section class="clock-app__panel clock-app__panel--centered" data-clock-app-target="panel" data-panel="stopwatch" role="tabpanel">
      <p class="clock-app__display" data-clock-app-target="stopwatchDisplay">00:00.00</p>
      <div class="clock-app__controls">
        <button type="button" class="clock-app__btn clock-app__btn--primary" data-clock-app-target="stopwatchStartBtn" data-action="clock-app#startStopwatch">Start</button>
        <button type="button" class="clock-app__btn" data-action="clock-app#lapStopwatch">Lap</button>
        <button type="button" class="clock-app__btn clock-app__btn--danger" data-action="clock-app#resetStopwatch">Reset</button>
      </div>
      <div class="clock-app__laps" data-clock-app-target="lapsList"></div>
    </section>

    <section class="clock-app__panel clock-app__panel--centered" data-clock-app-target="panel" data-panel="timer" role="tabpanel" hidden>
      <p class="clock-app__display" data-clock-app-target="timerDisplay">00:00</p>
      <div class="clock-app__timer-input-row">
        <input type="text" class="clock-app__input" data-clock-app-target="timerCustomInput" data-action="keydown.enter->clock-app#applyTimerTextInput blur->clock-app#applyTimerTextInput" placeholder="25m, 1:30, 1h 15m" aria-label="Timer duration">
      </div>
      <div class="clock-app__controls">
        <button type="button" class="clock-app__btn clock-app__btn--primary" data-clock-app-target="timerStartBtn" data-action="clock-app#startTimer">Start</button>
        <button type="button" class="clock-app__btn" data-clock-app-target="timerPauseBtn" data-action="clock-app#pauseTimer">Pause</button>
        <button type="button" class="clock-app__btn clock-app__btn--danger" data-action="clock-app#resetTimer">Reset</button>
      </div>
      <label class="clock-app__auto-repeat" aria-label="Auto repeat timer">
        <input type="checkbox" data-clock-app-target="timerAutoRepeatInput" data-action="change->clock-app#toggleTimerAutoRepeat">
        <span>Auto repeat</span>
      </label>
    </section>
  </section>
</turbo-frame>
