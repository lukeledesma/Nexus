<%# Finder: settings-style section panel on the left, selected section contents on the right. %>
<% frame_id = params[:frame_id].presence || turbo_frame_request_id.presence || "finder-pane" %>
<turbo-frame id="<%= frame_id %>">
  <section
    class="app-surface app-surface--tool app-surface--finder app-surface--settings"
    data-controller="finder-browser finder-tree"
    data-finder-browser-frame-id-value="<%= frame_id %>"
    data-finder-browser-root-folder-id-value="<%= @root_folder&.id %>"
    data-finder-browser-section-key-value="<%= @section_key %>"
    data-finder-browser-search-mode-value="<%= @finder_search_mode %>"
    data-finder-browser-read-only-value="<%= @finder_read_only %>"
    data-finder-browser-read-only-can-save-value="<%= @finder_read_only_can_save %>"
    <% if @finder_read_only %>data-finder-browser-linked-app-save-icon-value="<%= @linked_app_save_icon %>"<% end %>
    data-finder-tree-frame-id-value="<%= frame_id %>"
  >
    <div class="finder-shell os-window-body-start<%= " finder-shell--tree-only" if @finder_single_section_mode %>">
      <% unless @finder_single_section_mode %>
        <aside class="finder-shell-pane finder-shell-pane--folders" aria-label="Finder sections">
          <ul class="finder-folder-list settings-sections-list">
            <% @finder_sections.each_with_index do |section, index| %>
              <% active = !@finder_search_mode && section[:key] == @section_key %>
              <% next_is_separator = @finder_sections[index + 1] && ["favorites", "trash"].include?(@finder_sections[index + 1][:key]) %>
              <li class="finder-folder-item<%= " is-active" if active %><%= " finder-folder-item--separator" if ["favorites", "trash"].include?(section[:key]) %><%= " finder-folder-item--bottom" if section[:key] == "trash" %><%= " finder-folder-item--pre-separator" if next_is_separator %>" data-finder-section-key="<%= section[:key] %>"
                <% if section[:folder] %>data-finder-section-folder-id="<%= section[:folder].id %>"<% end %>
                <% if !@finder_read_only && section[:key] == "favorites" %>data-action="dragover->finder-browser#favoritesSidebarDragOver dragleave->finder-browser#favoritesSidebarDragLeave drop->finder-browser#favoritesSidebarDrop"<% elsif !@finder_read_only && section[:key] == "trash" %>data-action="dragover->finder-browser#trashSidebarDragOver dragleave->finder-browser#trashSidebarDragLeave drop->finder-browser#trashSidebarDrop"<% elsif !@finder_read_only && section[:folder] %>data-action="dragover->finder-browser#sectionSidebarDragOver dragleave->finder-browser#sectionSidebarDragLeave drop->finder-browser#sectionSidebarDrop"<% end %>>
                <%= link_to apps_finder_path({ section: section[:key], frame_id: frame_id }.merge(@finder_read_only ? { mode: "save_as" } : {})), class: "finder-folder-link", data: { turbo_frame: frame_id, turbo_prefetch: false }, aria: { label: "Open #{section[:title]}" } do %>
                  <span class="finder-folder-icon" aria-hidden="true">
                    <% if section[:icon_svg] %>
                      <%= render "shared/#{section[:icon_partial] || "quartz_icon"}" %>
                    <% else %>
                      <%= material_symbol_icon(section[:icon], size: :md) %>
                    <% end %>
                  </span>
                  <span class="finder-folder-name"><%= section[:title] %></span>
                <% end %>
                <% if section[:is_pinned_folder] && !@finder_read_only %>
                  <%# Unpin button hidden - use tree view buttons for pin/unpin management %>
                <% end %>
              </li>
            <% end %>
          </ul>
        </aside>
      <% end %>

      <section class="finder-shell-pane finder-shell-pane--contents" aria-label="<%= @finder_search_mode ? "Search results" : @finder_section_label %> content">
        <% if @finder_search_mode %>
          <div
            class="finder-browser-search-mode"
            data-controller="side-panel-search"
            data-side-panel-search-search-url-value="<%= panel_search_documents_path %>"
          >
            <div class="finder-browser-search-row">
              <label class="desktop-side-panel-search finder-browser-search" aria-label="Search all Finder files">
                <span class="desktop-side-panel-search-icon" aria-hidden="true"><%= material_symbol_icon(:search, size: :xs) %></span>
                <input
                  type="search"
                  class="desktop-side-panel-search-input finder-browser-search-input"
                  placeholder="Search all files"
                  value=""
                  autocomplete="off"
                  spellcheck="false"
                  data-side-panel-search-target="input"
                  data-action="input->side-panel-search#handleInput keydown->side-panel-search#handleInputKeydown"
                >
              </label>
            </div>

            <div class="finder-browser-content-surface">
              <nav class="desktop-side-panel-apps finder-search-seed-list" aria-label="All Finder files" data-side-panel-search-target="apps">
                <ul class="finder-tree" role="tree">
                  <% @finder_search_seed_rows.each_with_index do |row, index| %>
                    <% next if row[:id].blank? %>
                    <%= render "tree_node",
                          node: row,
                          is_last_child: index == @finder_search_seed_rows.size - 1,
                          browse_folder_id: @browse_folder&.id,
                          expanded_folder_ids: @expanded_folder_ids,
                          frame_id: frame_id,
                          section_key: @section_key,
                          read_only: @finder_read_only,
                          read_only_can_save: @finder_read_only_can_save,
                          open_in_app_content_types: @open_in_app_content_types %>
                  <% end %>
                </ul>
              </nav>

              <nav class="desktop-side-panel-apps finder-search-results-list" aria-label="Search results" data-side-panel-search-target="results" hidden></nav>
              <p class="desktop-side-panel-search-empty finder-search-empty-state" data-side-panel-search-target="emptyState" hidden>No Finder files matched.</p>
            </div>
          </div>
        <% else %>
        <% if @root_folder %>
          <div class="finder-browser-content-surface finder-browser-root-drop-zone">
            <div class="finder-browser-content-tree">
              <ul class="finder-tree finder-tree--root" role="tree">
                <% @tree_nodes.each_with_index do |node, index| %>
                  <%= render "tree_node",
                        node: node,
                        is_last_child: index == @tree_nodes.size - 1,
                        browse_folder_id: @browse_folder&.id,
                        expanded_folder_ids: @expanded_folder_ids,
                        frame_id: frame_id,
                        section_key: @section_key,
                        read_only: @finder_read_only,
                        read_only_can_save: @finder_read_only_can_save,
                        open_in_app_content_types: @open_in_app_content_types %>
                <% end %>
                <% unless @finder_read_only %>
                  <li
                    class="finder-tree__node finder-tree__node--folder finder-tree__node--root-drop-target"
                    data-finder-tree-node-id="<%= @root_folder.id %>"
                    data-finder-folder-writable="true"
                    aria-hidden="true"
                  >
                    <div class="finder-tree__row-line finder-tree__root-drop-spacer"></div>
                  </li>
                <% end %>
              </ul>
            </div>
            <% if @tree_nodes.empty? %>
              <div class="finder-empty-wrap finder-empty-wrap--content">
                <p class="finder-empty-state">No folders or files in <%= @finder_section_label %> yet.</p>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="finder-empty-wrap finder-empty-wrap--content">
            <p class="finder-empty-state"><%= @finder_empty_message.presence || "Nothing to show." %></p>
          </div>
        <% end %>
        <% end %>
      </section>
    </div>
  </section>
</turbo-frame>
