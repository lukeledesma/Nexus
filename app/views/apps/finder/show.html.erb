<%# Finder: turbo-frame body for content-window; tree + browse use finder-browser / finder-tree. %>
<% frame_id = params[:frame_id].presence || turbo_frame_request_id.presence || "finder-pane" %>
<turbo-frame id="<%= frame_id %>">
  <section
    class="app-surface app-surface--tool app-surface--finder"
    data-controller="finder-browser finder-tree"
    data-finder-browser-frame-id-value="<%= frame_id %>"
    data-finder-browser-root-folder-id-value="<%= @root_folder&.id %>"
    data-finder-browser-read-only-value="<%= @finder_read_only %>"
    <% if @finder_read_only %>data-finder-browser-singular-save-icon-value="<%= @singular_save_icon %>"<% end %>
    data-finder-tree-frame-id-value="<%= frame_id %>"
  >
    <div class="finder-shell finder-shell--tree-only os-window-body-start">
      <aside class="finder-shell-pane finder-shell-pane--folders" aria-label="Finder">
        <% if @root_folder && @tree_nodes.any? %>
          <ul class="finder-tree finder-tree--root" role="tree">
            <% @tree_nodes.each_with_index do |node, index| %>
              <%= render "tree_node",
                    node: node,
                    is_last_child: index == @tree_nodes.size - 1,
                    browse_folder_id: @browse_folder&.id,
                    expanded_folder_ids: @expanded_folder_ids,
                    frame_id: frame_id,
                    read_only: @finder_read_only,
                    open_in_app_content_types: @open_in_app_content_types %>
            <% end %>
          </ul>
        <% elsif @root_folder %>
          <ul class="finder-tree finder-tree--root" role="tree"></ul>
          <div class="finder-empty-wrap finder-empty-wrap--folders finder-folder-list-empty finder-tree-empty-hint">
            <p class="finder-empty-state">No folders or files in Finder yet.</p>
          </div>
        <% else %>
          <div class="finder-empty-wrap finder-empty-wrap--folders finder-folder-list-empty">
            <p class="finder-empty-state"><%= @finder_empty_message.presence || "Nothing to show." %></p>
          </div>
        <% end %>
      </aside>
    </div>
  </section>
</turbo-frame>
