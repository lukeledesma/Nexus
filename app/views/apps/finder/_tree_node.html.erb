<%# Recursive tree row. node: { kind:, id?, title, writable, children?, ... }; browse_folder_id + expanded_folder_ids drive open/selected state. %>
<% read_only = local_assigns.fetch(:read_only, false) %>
<% read_only_can_save = local_assigns.fetch(:read_only_can_save, false) %>
<% open_in_app_content_types = local_assigns.fetch(:open_in_app_content_types, %w[task_list]) %>
<% section_key = local_assigns.fetch(:section_key, "documents") %>
<% is_folder = node[:kind] == :folder %>
<% children = is_folder ? Array(node[:children]) : [] %>
<% has_children = children.any? %>
<% expanded_ids = local_assigns.fetch(:expanded_folder_ids) %>
<% branch_open = has_children && expanded_ids.include?(node[:id]) %>
<% writable = node.fetch(:writable, true) %>
<% connector =
     local_assigns.fetch(:is_last_child, true) ? "finder-tree__node--connector-end" : "finder-tree__node--connector-branch" %>
<li
  class="finder-tree__node<%= " finder-tree__node--folder" if is_folder %><%= " finder-tree__node--file" unless is_folder %><%= " finder-tree__node--has-children" if is_folder && has_children %> <%= connector %><%= " is-collapsed" if is_folder && has_children && !branch_open %>"
  <% if is_folder %>data-finder-folder-writable="<%= writable %>"<% end %>
  <% if node[:id] %>data-finder-tree-node-id="<%= node[:id] %>"
  data-rename-url="<%= rename_document_path(node[:id]) %>"
  data-delete-url="<%= document_path(node[:id]) %>"
  data-storage-name="<%= is_folder ? node[:title].to_s : node.fetch(:storage_name, node[:title]).to_s %>"
  data-display-title="<%= node[:title].to_s %>"<% end %>
>
  <% if is_folder %>
    <% folder_selected =
         browse_folder_id.present? &&
           browse_folder_id == node[:id] &&
           (!has_children || branch_open) %>
    <% folder_href = apps_finder_path({ frame_id: frame_id, browse_id: node[:id] }.merge(read_only ? { mode: "save_as" } : {})) %>
    <div
      class="finder-tree__row-line<%= ' is-selected' if folder_selected %>"
      draggable="<%= (writable && !read_only) ? "true" : "false" %>"
      data-action="click->finder-browser#activateRowLine"
    >
      <%= link_to folder_href,
            class: "finder-tree__row finder-tree__row--folder",
            draggable: false,
            data: { turbo_frame: frame_id },
            role: "treeitem",
            tabindex: "0",
            aria: {
              label: "Folder #{node[:title]}",
              expanded: (has_children ? (branch_open ? "true" : "false") : nil)
            }.compact do %>
        <span
          class="finder-tree__icon finder-tree__icon--folder<%= " finder-tree__icon--folder-empty" unless has_children %>"
          aria-hidden="true"
        >
          <%= material_symbol_icon(:folder, size: :sm) %>
        </span>
        <span class="finder-tree__label" data-finder-tree-label><%= node[:title] %></span>
      <% end %>
      <% if read_only && read_only_can_save && writable %>
        <div class="finder-tree__row-actions finder-tree__row-actions--save-here">
          <button
            type="button"
            class="row-save-here item-action-btn"
            title="Save here"
            aria-label="Save into folder <%= node[:title] %>"
            data-parent-id="<%= node[:id] %>"
            data-action="click->finder-browser#beginSaveFileHere"
          ><%= material_symbol_icon(:save, size: :xs) %></button>
        </div>
      <% end %>
      <% if writable && !read_only %>
        <div class="finder-tree__row-actions">
          <button
            type="button"
            class="row-plus"
            title="New folder inside"
            aria-label="New folder inside <%= node[:title] %>"
            data-parent-id="<%= node[:id] %>"
            data-action="click->finder-browser#createSubfolder"
          ><%= material_symbol_icon(:add, size: :xs) %></button>
          <% if section_key == "storage" %>
            <button
              type="button"
              class="item-action-btn item-action-pin<%= " is-pinned" if node[:is_pinned] %>"
              title="<%= node[:is_pinned] ? "Unpin folder" : "Pin folder" %>"
              aria-label="<%= node[:is_pinned] ? "Unpin" : "Pin" %> <%= node[:title] %>"
              data-action="click->finder-browser#togglePin"
              data-document-id="<%= node[:id] %>"
            ><% if node[:is_pinned] %><%= render "shared/keep_off_icon" %><% else %><%= render "shared/keep_icon" %><% end %></button>
          <% end %>
          <button
            type="button"
            class="item-action-btn item-action-rename"
            title="Rename"
            aria-label="Rename folder <%= node[:title] %>"
            data-action="click->finder-browser#renameFolder"
          ><%= material_symbol_icon(:edit, size: :xs) %></button>
          <button
            type="button"
            class="item-action-btn item-action-delete"
            title="Delete"
            aria-label="Delete folder <%= node[:title] %>"
            data-action="click->finder-browser#deleteFolder"
          ><%= material_symbol_icon(:delete, size: :xs) %></button>
        </div>
      <% end %>
    </div>
    <% if has_children %>
      <ul class="finder-tree" role="group">
        <% children.each_with_index do |child, idx| %>
          <%= render "tree_node",
                node: child,
                is_last_child: idx == children.size - 1,
                browse_folder_id: browse_folder_id,
                expanded_folder_ids: expanded_ids,
                frame_id: frame_id,
                section_key: section_key,
                read_only: read_only,
                read_only_can_save: read_only_can_save,
                open_in_app_content_types: open_in_app_content_types %>
        <% end %>
      </ul>
    <% end %>
  <% else %>
    <% in_trash = node.fetch(:in_trash, false) %>
    <% file_linked = node.fetch(:has_linked_app, false) %>
    <% file_linked = false if in_trash %>
    <% show_open_in_app = file_linked && open_in_app_content_types.include?(node[:content_type].to_s) %>
    <% finder_open_doc_title = finder_document_display_title(node[:title].to_s) %>
    <% effective_section_key = node[:origin_section_key].presence || section_key %>
    <% thumb_url = node[:thumbnail_url].presence %>
    <div class="finder-tree__row-line" draggable="<%= (writable && !read_only) ? "true" : "false" %>" data-action="click->finder-browser#activateRowLine">
      <% if file_linked && !read_only %>
        <%= link_to "#",
              class: "finder-tree__row finder-tree__row--file",
              draggable: false,
              data: {
                turbo: false,
                document_id: node[:id],
                content_type: node[:content_type],
                file_kind: node[:file_kind],
                document_title: finder_open_doc_title,
                section_key: effective_section_key,
                action: "click->finder-browser#openLinkedFile keydown->finder-browser#openLinkedFileKey"
              },
              role: "treeitem",
              tabindex: "0",
              aria: { label: "Open #{node[:title]}" } do %>
          <% if thumb_url %>
            <span class="finder-tree__icon finder-tree__icon--thumb" aria-hidden="true">
              <img class="finder-tree__thumb" src="<%= thumb_url %>" alt="" loading="lazy" decoding="async" onerror="this.style.visibility='hidden'">
            </span>
          <% else %>
            <span class="finder-tree__icon finder-tree__icon--file" aria-hidden="true">
              <% if finder_quartz_note_file?(node[:content_type], section_key: effective_section_key) %>
                <%= render "shared/quartz_icon" %>
              <% elsif finder_alchemy_file?(node[:content_type]) %>
                <%= render "shared/alchemy_icon" %>
              <% else %>
                <%= material_symbol_icon(finder_file_icon_for_content_type(node[:content_type], source_extension: node[:source_extension], section_key: effective_section_key), size: :sm) %>
              <% end %>
            </span>
          <% end %>
          <span class="finder-tree__label" data-finder-tree-label><%= node[:title] %></span>
        <% end %>
      <% elsif file_linked && read_only %>
        <%= link_to "#",
              class: "finder-tree__row finder-tree__row--file",
              draggable: false,
              data: {
                turbo: false,
                document_id: node[:id],
                content_type: node[:content_type],
                file_kind: node[:file_kind],
                document_title: finder_open_doc_title,
                section_key: effective_section_key,
                action: "click->finder-browser#openLinkedFileInApp keydown->finder-browser#openLinkedFileInAppKey"
              },
              role: "treeitem",
              tabindex: "0",
              aria: { label: "Open #{node[:title]}" } do %>
          <% if thumb_url %>
            <span class="finder-tree__icon finder-tree__icon--thumb" aria-hidden="true">
              <img class="finder-tree__thumb" src="<%= thumb_url %>" alt="" loading="lazy" decoding="async" onerror="this.style.visibility='hidden'">
            </span>
          <% else %>
            <span class="finder-tree__icon finder-tree__icon--file" aria-hidden="true">
              <% if finder_quartz_note_file?(node[:content_type], section_key: effective_section_key) %>
                <%= render "shared/quartz_icon" %>
              <% elsif finder_alchemy_file?(node[:content_type]) %>
                <%= render "shared/alchemy_icon" %>
              <% else %>
                <%= material_symbol_icon(finder_file_icon_for_content_type(node[:content_type], source_extension: node[:source_extension], section_key: effective_section_key), size: :sm) %>
              <% end %>
            </span>
          <% end %>
          <span class="finder-tree__label" data-finder-tree-label><%= node[:title] %></span>
        <% end %>
      <% else %>
        <span
          class="finder-tree__row finder-tree__row--file finder-tree__row--file-no-app"
          role="treeitem"
          tabindex="0"
          aria-label="<%= node[:title] %> (no app for this type yet)"
        >
          <% if thumb_url %>
            <span class="finder-tree__icon finder-tree__icon--thumb" aria-hidden="true">
              <img class="finder-tree__thumb" src="<%= thumb_url %>" alt="" loading="lazy" decoding="async" onerror="this.style.visibility='hidden'">
            </span>
          <% else %>
            <span class="finder-tree__icon finder-tree__icon--file" aria-hidden="true">
              <% if finder_quartz_note_file?(node[:content_type], section_key: effective_section_key) %>
                <%= render "shared/quartz_icon" %>
              <% elsif finder_alchemy_file?(node[:content_type]) %>
                <%= render "shared/alchemy_icon" %>
              <% else %>
                <%= material_symbol_icon(finder_file_icon_for_content_type(node[:content_type], source_extension: node[:source_extension], section_key: effective_section_key), size: :sm) %>
              <% end %>
            </span>
          <% end %>
          <span class="finder-tree__label" data-finder-tree-label><%= node[:title] %></span>
        </span>
      <% end %>

      <% if writable && !read_only %>
        <% is_favorited = node.fetch(:is_favorited, false) %>
        <% is_image_asset = node[:content_type].to_s == "asset" && node[:file_kind].to_s == "image" %>
        <div class="finder-tree__row-actions">
          <% if in_trash %>
            <button
              type="button"
              class="item-action-btn item-action-restore"
              title="Restore"
              aria-label="Restore <%= node[:title] %>"
              data-action="click->finder-browser#restoreFromTrash"
            ><%= render "shared/restore_from_trash_icon" %></button>
            <button
              type="button"
              class="item-action-btn item-action-delete-forever"
              title="Delete permanently"
              aria-label="Delete <%= node[:title] %> permanently"
              data-document-id="<%= node[:id] %>"
              data-display-title="<%= node[:title] %>"
              data-action="click->finder-browser#permanentDeleteFromTrash"
            ><%= render "shared/delete_forever_icon" %></button>
          <% else %>
            <button
              type="button"
              class="item-action-btn item-action-favorite"
              title="<%= is_favorited ? "Remove from Favorites" : "Add to Favorites" %>"
              aria-label="<%= is_favorited ? "Remove from Favorites" : "Add to Favorites" %>"
              data-document-id="<%= node[:id] %>"
              data-is-favorited="<%= is_favorited %>"
              data-action="click->finder-browser#toggleFavorite"
            ><span class="item-action-favorite__filled"><%= material_symbol_icon(:star_rounded, size: :xs) %></span><span class="item-action-favorite__outline"><%= material_symbol_icon(:star_outline_rounded, size: :xs) %></span></button>
            <% if is_image_asset %>
              <button
                type="button"
                class="item-action-btn item-action-set-wallpaper"
                title="Set as desktop display"
                aria-label="Set <%= node[:title] %> as desktop display"
                data-document-id="<%= node[:id] %>"
                data-action="click->finder-browser#setFileAsWallpaper"
              ><%= material_symbol_icon(:desktop_windows, size: :xs) %></button>
            <% end %>
            <button
              type="button"
              class="item-action-btn item-action-rename"
              title="Rename"
              aria-label="Rename <%= node[:title] %>"
              data-action="click->finder-browser#renameFile"
            ><%= material_symbol_icon(:edit, size: :xs) %></button>
            <button
              type="button"
              class="item-action-btn item-action-delete"
              title="Delete"
              aria-label="Delete <%= node[:title] %>"
              data-action="click->finder-browser#deleteFile"
            ><%= material_symbol_icon(:delete, size: :xs) %></button>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
</li>