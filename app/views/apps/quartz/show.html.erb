<% frame_id = params[:frame_id].presence || turbo_frame_request_id.presence || "quartz-pane" %>
<turbo-frame id="<%= frame_id %>">
  <section class="app-surface app-surface--tool quartz-app os-window-body-start"
    data-controller="quartz"
    data-quartz-linked-document-id-value="<%= @linked_document_id || 0 %>"
    data-quartz-initial-body-value="<%= @initial_body %>">

    <% if @linked_document_id.present? %>
      <%# ── Linked-document mode: autosave form ────────────────────────── %>
      <%= form_with url: document_path(@linked_document_id), method: :patch,
            data: {
              turbo: false,
              controller: "autosave",
              autosave_debounce_value: 180,
              autosave_submit_on_input_value: false
            },
            html: { class: "quartz-app__form" } do %>

        <input type="hidden"
               name="document[content]"
               value="<%= @serialized_document_content %>"
               data-quartz-target="serializedContent">

        <%= render "apps/quartz/editor_shell" %>
      <% end %>

    <% else %>
      <%# ── Standalone mode: no persistence form ────────────────────────── %>
      <div class="quartz-app__form">
        <input type="hidden" value="" data-quartz-target="serializedContent">
        <%= render "apps/quartz/editor_shell" %>
      </div>
    <% end %>

  </section>
</turbo-frame>
