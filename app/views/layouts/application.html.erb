<!DOCTYPE html>
<html<%= workspace_theme_boot_html_attributes %>>
  <head>
    <title><%= content_for(:title) || "NEXUS" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="NEXUS">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= action_cable_meta_tag %>
    <% if logged_in? %>
      <meta name="nexus-user-id" content="<%= current_user.id %>">
    <% end %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="shortcut icon" href="/favicon-32.png?v=2" type="image/png">
    <link rel="icon" href="/favicon-32.png?v=2" sizes="32x32" type="image/png">
    <link rel="icon" href="/favicon.png?v=2" type="image/png">
    <link rel="icon" href="/icon.png?v=2" type="image/png">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= workspace_theme_boot_style_tag %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="<%= logged_in? ? "nexus-os" : "" %>" data-controller="window-manager workspace-draft-tracker user-security-modal">
    <% if logged_in? %>
      <div id="desktop" class="desktop-layer" data-controller="desktop-selection"<%= workspace_desktop_boot_layer_attributes %>></div>
      <div class="desktop-clock" data-controller="desktop-clock">
        <span class="desktop-clock-display" data-desktop-clock-target="display"></span>
      </div>

      <%= render "shared/desktop_side_panel" %>

      <div id="desktop-shell">
        <div id="desktop-shell-canvas">
      <section class="content-window os-window is-hidden"
        data-controller="content-window finder-toolbar"
        data-finder-toolbar-frame-id-value="finder-pane"
        data-content-window-app-key-value="finder"
        data-content-window-app-url-value="/apps/finder"
        data-content-window-storage-key-value="nexus.contentWindow.finder.bounds"
        data-content-window-frame-id-value="finder-pane"
        aria-live="polite">
        <%= render "shared/content_window_chrome", title: "Finder", show_finder_new_folder: true, show_finder_search_toggle: true %>
        <div class="pane-resize-handle pane-resize-handle--top" data-action="pointerdown->content-window#startResize mousedown->content-window#startResize touchstart->content-window#startResize"></div>
        <div class="pane-resize-handle pane-resize-handle--right" data-action="pointerdown->content-window#startResize mousedown->content-window#startResize touchstart->content-window#startResize"></div>
        <div class="pane-resize-handle pane-resize-handle--bottom" data-action="pointerdown->content-window#startResize mousedown->content-window#startResize touchstart->content-window#startResize"></div>
        <div class="pane-resize-handle pane-resize-handle--left" data-action="pointerdown->content-window#startResize mousedown->content-window#startResize touchstart->content-window#startResize"></div>
        <div class="pane-resize-handle pane-resize-handle--top-left" data-action="pointerdown->content-window#startResize mousedown->content-window#startResize touchstart->content-window#startResize"></div>
        <div class="pane-resize-handle pane-resize-handle--top-right" data-action="pointerdown->content-window#startResize mousedown->content-window#startResize touchstart->content-window#startResize"></div>
        <div class="pane-resize-handle pane-resize-handle--bottom-left" data-action="pointerdown->content-window#startResize mousedown->content-window#startResize touchstart->content-window#startResize"></div>
        <div class="pane-resize-handle pane-resize-handle--bottom-right" data-action="pointerdown->content-window#startResize mousedown->content-window#startResize touchstart->content-window#startResize"></div>
        <%= content_window_shell do %>
          <turbo-frame id="finder-pane" class="finder-app-frame" data-content-window-target="frame"></turbo-frame>
        <% end %>
      </section>

      <section class="content-window os-window is-hidden"
        data-controller="content-window"
        data-content-window-app-key-value="tasks"
        data-content-window-app-url-value="/apps/tasks"
        data-content-window-storage-key-value="nexus.contentWindow.tasks.bounds"
        data-content-window-frame-id-value="tasks-pane"
        data-content-window-has-linked-app-save-picker-value="true"
        aria-live="polite">
        <%= render "shared/content_window_chrome", title: "", open_file_badge: true, linked_app_save_flow: true, show_save: true, show_task_list_add: true %>
        <div class="pane-resize-handle pane-resize-handle--top" data-action="pointerdown->content-window#startResize mousedown->content-window#startResize touchstart->content-window#startResize"></div>
        <div class="pane-resize-handle pane-resize-handle--right" data-action="pointerdown->content-window#startResize mousedown->content-window#startResize touchstart->content-window#startResize"></div>
        <div class="pane-resize-handle pane-resize-handle--bottom" data-action="pointerdown->content-window#startResize mousedown->content-window#startResize touchstart->content-window#startResize"></div>
