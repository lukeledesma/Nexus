<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "NEXUS" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="NEXUS">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="shortcut icon" href="/favicon-32.png?v=2" type="image/png">
    <link rel="icon" href="/favicon-32.png?v=2" sizes="32x32" type="image/png">
    <link rel="icon" href="/favicon.png?v=2" type="image/png">
    <link rel="icon" href="/icon.png?v=2" type="image/png">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="<%= logged_in? ? "nexus-os" : "" %>" data-controller="window-manager workspace-draft-tracker user-security-modal">
    <% if logged_in? %>
      <div id="desktop" class="desktop-layer" data-controller="desktop-selection"></div>
      <div class="desktop-clock" data-controller="desktop-clock">
        <span class="desktop-clock-display" data-desktop-clock-target="display"></span>
      </div>

      <section id="organizer-window" class="os-window organizer-window is-hidden" aria-live="polite">
        <div class="window-content">
          <%= render "organizer/sidebar" %>
        </div>
      </section>

      <section class="content-window os-window is-hidden"
        data-controller="content-window finder-toolbar"
        data-finder-toolbar-frame-id-value="finder-pane"
        data-content-window-app-key-value="finder"
        data-content-window-app-url-value="/apps/finder"
        data-content-window-storage-key-value="nexus.contentWindow.finder.bounds"
        data-content-window-frame-id-value="finder-pane"
        aria-live="polite">
        <%= render "shared/content_window_chrome", title: "FINDER", show_finder_new_folder: true %>
        <div class="pane-resize-handle pane-resize-handle--top" data-action="mousedown->content-window#startResize touchstart->content-window#startResize"></div>
        <div class="pane-resize-handle pane-resize-handle--right" data-action="mousedown->content-window#startResize touchstart->content-window#startResize"></div>
        <div class="pane-resize-handle pane-resize-handle--bottom" data-action="mousedown->content-window#startResize touchstart->content-window#startResize"></div>
        <div class="pane-resize-handle pane-resize-handle--left" data-action="mousedown->content-window#startResize touchstart->content-window#startResize"></div>
        <div class="pane-resize-handle pane-resize-handle--top-left" data-action="mousedown->content-window#startResize touchstart->content-window#startResize"></div>
        <div class="pane-resize-handle pane-resize-handle--top-right" data-action="mousedown->content-window#startResize touchstart->content-window#startResize"></div>
        <div class="pane-resize-handle pane-resize-handle--bottom-left" data-action="mousedown->content-window#startResize touchstart->content-window#startResize"></div>
        <div class="pane-resize-handle pane-resize-handle--bottom-right" data-action="mousedown->content-window#startResize touchstart->content-window#startResize"></div>
        <div class="window-content">
          <turbo-frame id="finder-pane" class="finder-app-frame" data-content-window-target="frame"></turbo-frame>
        </div>
      </section>

      <section class="content-window os-window is-hidden"
        data-controller="content-window"
        data-content-window-app-key-value="singular-note"
        data-content-window-app-url-value="/apps/singular_note"
        data-content-window-storage-key-value="nexus.contentWindow.singularNote.bounds"
        data-content-window-frame-id-value="singular-note-pane"
        aria-live="polite">
        <%= render "shared/content_window_chrome", title: "NOTEPAD", show_save: true, open_file_badge: true %>
        <div class="pane-resize-handle pane-resize-handle--top" data-action="mousedown->content-window#startResize touchstart->content-window#startResize"></div>
        <div class="pane-resize-handle pane-resize-handle--right" data-action="mousedown->content-window#startResize touchstart->content-window#startResize"></div>
        <div class="pane-resize-handle pane-resize-handle--bottom" data-action="mousedown->content-window#startResize touchstart->content-window#startResize"></div>
        <div class="pane-resize-handle pane-resize-handle--left" data-action="mousedown->content-window#startResize touchstart->content-window#startResize"></div>
        <div class="pane-resize-handle pane-resize-handle--top-left" data-action="mousedown->content-window#startResize touchstart->content-window#startResize"></div>
        <div class="pane-resize-handle pane-resize-handle--top-right" data-action="mousedown->content-window#startResize touchstart->content-window#startResize"></div>
        <div class="pane-resize-handle pane-resize-handle--bottom-left" data-action="mousedown->content-window#startResize touchstart->content-window#startResize"></div>
        <div class="pane-resize-handle pane-resize-handle--bottom-right" data-action="mousedown->content-window#startResize touchstart->content-window#startResize"></div>
        <div class="window-content">
          <turbo-frame id="singular-note-pane" class="finder-app-frame" data-content-window-target="frame"></turbo-frame>
        </div>
      </section>

      <section class="content-window os-window is-hidden"
        data-controller="content-window"
        data-content-window-app-key-value="singular-task-list"
        data-content-window-app-url-value="/apps/singular_task_list"
        data-content-window-storage-key-value="nexus.contentWindow.singularTaskList.bounds"
        data-content-window-frame-id-value="singular-task-list-pane"
        aria-live="polite">
        <%= render "shared/content_window_chrome", title: "TASKS", show_save: true, open_file_badge: true, show_task_list_add: true %>
        <div class="pane-resize-handle pane-resize-handle--top" data-action="mousedown->content-window#startResize touchstart->content-window#startResize"></div>
        <div class="pane-resize-handle pane-resize-handle--right" data-action="mousedown->content-window#startResize touchstart->content-window#startResize"></div>
        <div class="pane-resize-handle pane-resize-handle--bottom" data-action="mousedown->content-window#startResize touchstart->content-window#startResize"></div>
        <div class="pane-resize-handle pane-resize-handle--left" data-action="mousedown->content-window#startResize touchstart->content-window#startResize"></div>
        <div class="pane-resize-handle pane-resize-handle--top-left" data-action="mousedown->content-window#startResize touchstart->content-window#startResize"></div>
        <div class="pane-resize-handle pane-resize-handle--top-right" data-action="mousedown->content-window#startResize touchstart->content-window#startResize"></div>
        <div class="pane-resize-handle pane-resize-handle--bottom-left" data-action="mousedown->content-window#startResize touchstart->content-window#startResize"></div>
        <div class="pane-resize-handle pane-resize-handle--bottom-right" data-action="mousedown->content-window#startResize touchstart->content-window#startResize"></div>
        <div class="window-content">
          <turbo-frame id="singular-task-list-pane" class="finder-app-frame" data-content-window-target="frame"></turbo-frame>
        </div>
      </section>

      <section class="content-window os-window is-hidden"
        data-controller="content-window"
        data-content-window-app-key-value="singular-sticky-notes"
        data-content-window-app-url-value="/apps/singular_sticky_notes"
        data-content-window-storage-key-value="nexus.contentWindow.singularStickyNotes.bounds"
        data-content-window-frame-id-value="singular-sticky-notes-pane"
        aria-live="polite">
        <%= render "shared/content_window_chrome", title: "STICKY NOTES", show_save: true, open_file_badge: true, show_sticky_notes_add: true %>
        <div class="pane-resize-handle pane-resize-handle--top" data-action="mousedown->content-window#startResize touchstart->content-window#startResize"></div>
        <div class="pane-resize-handle pane-resize-handle--right" data-action="mousedown->content-window#startResize touchstart->content-window#startResize"></div>
        <div class="pane-resize-handle pane-resize-handle--bottom" data-action="mousedown->content-window#startResize touchstart->content-window#startResize"></div>
        <div class="pane-resize-handle pane-resize-handle--left" data-action="mousedown->content-window#startResize touchstart->content-window#startResize"></div>
        <div class="pane-resize-handle pane-resize-handle--top-left" data-action="mousedown->content-window#startResize touchstart->content-window#startResize"></div>
        <div class="pane-resize-handle pane-resize-handle--top-right" data-action="mousedown->content-window#startResize touchstart->content-window#startResize"></div>
        <div class="pane-resize-handle pane-resize-handle--bottom-left" data-action="mousedown->content-window#startResize touchstart->content-window#startResize"></div>
        <div class="pane-resize-handle pane-resize-handle--bottom-right" data-action="mousedown->content-window#startResize touchstart->content-window#startResize"></div>
        <div class="window-content">
          <turbo-frame id="singular-sticky-notes-pane" class="finder-app-frame" data-content-window-target="frame"></turbo-frame>
        </div>
      </section>

      <section class="content-window os-window is-hidden"
        data-controller="content-window"
        data-content-window-app-key-value="singular-thread-board"
        data-content-window-app-url-value="/apps/singular_thread_board"
        data-content-window-storage-key-value="nexus.contentWindow.singularThreadBoard.bounds"
        data-content-window-frame-id-value="singular-thread-board-pane"
        aria-live="polite">
        <%= render "shared/content_window_chrome", title: "THREAD BOARD", show_save: true, open_file_badge: true %>
        <div class="pane-resize-handle pane-resize-handle--top" data-action="mousedown->content-window#startResize touchstart->content-window#startResize"></div>
        <div class="pane-resize-handle pane-resize-handle--right" data-action="mousedown->content-window#startResize touchstart->content-window#startResize"></div>
        <div class="pane-resize-handle pane-resize-handle--bottom" data-action="mousedown->content-window#startResize touchstart->content-window#startResize"></div>
        <div class="pane-resize-handle pane-resize-handle--left" data-action="mousedown->content-window#startResize touchstart->content-window#startResize"></div>
        <div class="pane-resize-handle pane-resize-handle--top-left" data-action="mousedown->content-window#startResize touchstart->content-window#startResize"></div>
        <div class="pane-resize-handle pane-resize-handle--top-right" data-action="mousedown->content-window#startResize touchstart->content-window#startResize"></div>
        <div class="pane-resize-handle pane-resize-handle--bottom-left" data-action="mousedown->content-window#startResize touchstart->content-window#startResize"></div>
        <div class="pane-resize-handle pane-resize-handle--bottom-right" data-action="mousedown->content-window#startResize touchstart->content-window#startResize"></div>
        <div class="window-content">
          <turbo-frame id="singular-thread-board-pane" class="finder-app-frame" data-content-window-target="frame"></turbo-frame>
        </div>
      </section>

      <section class="content-window os-window is-hidden"
        data-controller="content-window"
        data-content-window-app-key-value="habit-tracker"
        data-content-window-app-url-value="/apps/habit_tracker"
        data-content-window-storage-key-value="nexus.contentWindow.habitTracker.bounds"
        data-content-window-frame-id-value="habit-tracker-pane"
        aria-live="polite">
        <%= render "shared/content_window_chrome", title: "HABITS", show_habit_add: true %>
        <div class="pane-resize-handle pane-resize-handle--top" data-action="mousedown->content-window#startResize touchstart->content-window#startResize"></div>
        <div class="pane-resize-handle pane-resize-handle--right" data-action="mousedown->content-window#startResize touchstart->content-window#startResize"></div>
        <div class="pane-resize-handle pane-resize-handle--bottom" data-action="mousedown->content-window#startResize touchstart->content-window#startResize"></div>
        <div class="pane-resize-handle pane-resize-handle--left" data-action="mousedown->content-window#startResize touchstart->content-window#startResize"></div>
        <div class="pane-resize-handle pane-resize-handle--top-left" data-action="mousedown->content-window#startResize touchstart->content-window#startResize"></div>
        <div class="pane-resize-handle pane-resize-handle--top-right" data-action="mousedown->content-window#startResize touchstart->content-window#startResize"></div>
        <div class="pane-resize-handle pane-resize-handle--bottom-left" data-action="mousedown->content-window#startResize touchstart->content-window#startResize"></div>
        <div class="pane-resize-handle pane-resize-handle--bottom-right" data-action="mousedown->content-window#startResize touchstart->content-window#startResize"></div>
        <div class="window-content">
          <turbo-frame id="habit-tracker-pane" class="finder-app-frame" data-content-window-target="frame"></turbo-frame>
        </div>
      </section>

      <section class="content-window os-window is-hidden"
        data-controller="content-window"
        data-content-window-app-key-value="settings"
        data-content-window-app-url-value="/apps/settings"
        data-content-window-storage-key-value="nexus.contentWindow.settings.bounds"
        data-content-window-frame-id-value="settings-pane"
        aria-live="polite">
        <%= render "shared/content_window_chrome", title: "SETTINGS" %>
        <div class="pane-resize-handle pane-resize-handle--top" data-action="mousedown->content-window#startResize touchstart->content-window#startResize"></div>
        <div class="pane-resize-handle pane-resize-handle--right" data-action="mousedown->content-window#startResize touchstart->content-window#startResize"></div>
        <div class="pane-resize-handle pane-resize-handle--bottom" data-action="mousedown->content-window#startResize touchstart->content-window#startResize"></div>
        <div class="pane-resize-handle pane-resize-handle--left" data-action="mousedown->content-window#startResize touchstart->content-window#startResize"></div>
        <div class="pane-resize-handle pane-resize-handle--top-left" data-action="mousedown->content-window#startResize touchstart->content-window#startResize"></div>
        <div class="pane-resize-handle pane-resize-handle--top-right" data-action="mousedown->content-window#startResize touchstart->content-window#startResize"></div>
        <div class="pane-resize-handle pane-resize-handle--bottom-left" data-action="mousedown->content-window#startResize touchstart->content-window#startResize"></div>
        <div class="pane-resize-handle pane-resize-handle--bottom-right" data-action="mousedown->content-window#startResize touchstart->content-window#startResize"></div>
        <div class="window-content">
          <turbo-frame id="settings-pane" class="finder-app-frame" data-content-window-target="frame"></turbo-frame>
        </div>
      </section>

      <section class="content-window os-window is-hidden"
        data-controller="content-window"
        data-content-window-app-key-value="user"
        data-content-window-app-url-value="/apps/user"
        data-content-window-storage-key-value="nexus.contentWindow.user.bounds"
        data-content-window-frame-id-value="user-pane"
        aria-live="polite">
        <%= render "shared/content_window_chrome", title: "USER" %>
        <div class="pane-resize-handle pane-resize-handle--top" data-action="mousedown->content-window#startResize touchstart->content-window#startResize"></div>
        <div class="pane-resize-handle pane-resize-handle--right" data-action="mousedown->content-window#startResize touchstart->content-window#startResize"></div>
        <div class="pane-resize-handle pane-resize-handle--bottom" data-action="mousedown->content-window#startResize touchstart->content-window#startResize"></div>
        <div class="pane-resize-handle pane-resize-handle--left" data-action="mousedown->content-window#startResize touchstart->content-window#startResize"></div>
        <div class="pane-resize-handle pane-resize-handle--top-left" data-action="mousedown->content-window#startResize touchstart->content-window#startResize"></div>
        <div class="pane-resize-handle pane-resize-handle--top-right" data-action="mousedown->content-window#startResize touchstart->content-window#startResize"></div>
        <div class="pane-resize-handle pane-resize-handle--bottom-left" data-action="mousedown->content-window#startResize touchstart->content-window#startResize"></div>
        <div class="pane-resize-handle pane-resize-handle--bottom-right" data-action="mousedown->content-window#startResize touchstart->content-window#startResize"></div>
        <div class="window-content">
          <turbo-frame id="user-pane" class="finder-app-frame" data-content-window-target="frame"></turbo-frame>
        </div>
      </section>

      <%= render "shared/app_save_dialog", frame_id: "singular-note-pane", default_filename: "Notes" %>
      <%= render "shared/app_save_dialog", frame_id: "singular-task-list-pane", default_filename: "Tasks" %>
      <%= render "shared/app_save_dialog", frame_id: "singular-sticky-notes-pane", default_filename: "Sticky notes" %>
      <%= render "shared/app_save_dialog", frame_id: "singular-thread-board-pane", default_filename: "Thread board" %>

      <%= render "apps/user/security_modals", frame_id: "settings-pane" %>

      <%= render "shared/ollama_helper" %>

    <% end %>

    <%= yield %>
  </body>
</html>
