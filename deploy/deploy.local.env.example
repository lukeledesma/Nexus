# One-time setup: copy this file and edit (never commit the copy).
#
#   cp deploy/deploy.local.env.example deploy/deploy.local.env
#
# Then set at least NEXUS_DEPLOY_HOST. After that, ./deploy/deploy_server.sh
# works without typing export in every terminal session.
#
# Host can be your domain (if SSH listens there), a hostname, or the server IP.
# User must match whoever you SSH as (defaults in deploy_server.sh assume `deploy`).

export NEXUS_DEPLOY_HOST=nxs.tools
export NEXUS_DEPLOY_USER=luke

# Uncomment only if paths on the server differ from /home/$NEXUS_DEPLOY_USER/... :
# export NEXUS_DEPLOY_APP=/home/luke/apps/nexus
# export NEXUS_DEPLOY_RUBY=/home/luke/.rbenv/versions/3.2.3/bin
# export NEXUS_DEPLOY_SSH_KEY=$HOME/.ssh/id_ed25519
