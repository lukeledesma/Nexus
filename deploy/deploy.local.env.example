# One-time setup: copy this file and edit (never commit the copy).
#
#   cp deploy/deploy.local.env.example deploy/deploy.local.env
#
# Then set at least NEXUS_DEPLOY_HOST. After that, ./deploy/deploy_server.sh
# works without typing export in every terminal session.

export NEXUS_DEPLOY_HOST=your.server.hostname.or.ip
export NEXUS_DEPLOY_USER=deploy

# Uncomment if your server layout differs from defaults in deploy/deploy_server.sh:
# export NEXUS_DEPLOY_APP=/home/deploy/apps/nexus
# export NEXUS_DEPLOY_RUBY=/home/deploy/.rbenv/versions/3.2.3/bin
# export NEXUS_DEPLOY_SSH_KEY=$HOME/.ssh/id_ed25519
